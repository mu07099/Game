vision_range = 64;        // how far they can see (2 tiles = 64px)
vision_angle = 45;        // half of cone angle (90° total)



// --- Combat / Damage Variables ---
hp = 3;                  // how many punches to kill the zombie
hit_flash_timer = 0;     // how long to flash red after being hit
is_dead = false;         // prevent double-kill